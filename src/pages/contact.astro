---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import '../styles/global.css';

const title = 'Contact Kakerio about WhatChar';
const description = 'Contact the Kakerio team about WhatChar questions, problems and feedback.';
const contactEmail = 'contact@kakerio.com';
---

<BaseLayout title={title} description={description} lang="en" locale="en" path="/contact/">
  <header class="topbar">
    <Brand />
  </header>

  <main class="page-shell">
    <section class="seo-copy legal-page">
      <h1>Contact Kakerio about WhatChar</h1>

      <p>
        WhatChar is a tool by <a href="https://kakerio.com/en/">Kakerio</a>.
        For questions, accessibility issues or feedback about WhatChar, use our shared contact:
      </p>

      <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>

      <p>
        Please do not email passwords, private documents, pasted source text or other
        confidential material. A description of the steps and the browser you used is enough.
        WhatChar never attaches your analyzed text to an email.
      </p>

      <p>
        The link opens your email application. No email is sent unless you choose to send it.
      </p>
    </section>
  </main>

  <footer class="footer">
    <span><a href="/">Home</a></span>
    <span><a href="/about/">About</a></span>
    <span><a href="/privacy/">Privacy</a></span>
  </footer>
</BaseLayout>
