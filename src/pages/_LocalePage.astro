---
import BaseLayout from '../layouts/BaseLayout.astro';
import Analyzer from '../components/Analyzer';
import Brand from '../components/Brand.astro';
import { messages } from '../i18n/messages';
import { kakerioUrl, localePaths, locales, type Locale } from '../i18n/config';
import '../styles/global.css';

const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = messages[locale];
const heroCharacters = new Set(['I', 'l', '1', 'O', '0']);
const heroParts = t.hero.split(/(?<![\p{L}\p{N}])([Il1O0])(?![\p{L}\p{N}])/gu);
---

<BaseLayout title={t.title} description={t.description} lang={t.lang} locale={locale}>
  <header class="topbar">
    <Brand locale={locale} home={localePaths[locale]} />
    <nav class="language" aria-label="Language">
      {locales.map((code, index) => (
        <>
          <a aria-current={code === locale ? 'page' : undefined} href={localePaths[code]}>{code.toUpperCase()}</a>
          {index < locales.length - 1 && <span>/</span>}
        </>
      ))}
    </nav>
  </header>

  <main class="page-shell">
    <section class="hero">
      <h1>
        {heroParts.map((part) => heroCharacters.has(part) ? <span>{part}</span> : part)}
      </h1>
      <p>{t.subtitle}</p>
    </section>

    <Analyzer client:load locale={locale} />

    <section class="seo-copy" aria-labelledby="what-checks">
      <h2 id="what-checks">{t.seoTitle}</h2>
      <p>{t.seoBody}</p>
      <div class="mini-grid">
        {t.seoCards.map((card) => (
          <div>
            <strong>{card.title}</strong>
            <span>{card.body}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="seo-copy quick-ref-section">
      <h2>{t.quickRefTitle}</h2>
      <p>{t.quickRefNote}</p>
      <div class="ref-tables">
        <div class="ref-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Char</th>
                <th scope="col">Code point</th>
                <th scope="col">Unicode Name</th>
              </tr>
            </thead>
            <tbody>
              {t.quickRefItemsA.map((item) => (
                <tr>
                  <td><span class="ref-char">{item.char}</span></td>
                  <td><code>{item.codePoint}</code></td>
                  <td>{item.name}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ref-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Char</th>
                <th scope="col">Code point</th>
                <th scope="col">Unicode Name</th>
              </tr>
            </thead>
            <tbody>
              {t.quickRefItemsB.map((item) => (
                <tr>
                  <td><span class="ref-char">{item.char}</span></td>
                  <td><code>{item.codePoint}</code></td>
                  <td>{item.name}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="seo-copy use-cases-section">
      <h2>{t.useCasesTitle}</h2>
      <div class="mini-grid">
        {t.useCases.map((uc) => (
          <div>
            <strong>{uc.title}</strong>
            <span>{uc.body}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="seo-copy kakerio-section" aria-labelledby="kakerio-tools">
      <h2 id="kakerio-tools">{t.kakerio.title}</h2>
      <p>{t.kakerio.lead}</p>
      <ul class="kakerio-tools">
        {t.kakerio.tools.map((tool) => (
          <li>
            <a href={kakerioUrl(locale, `tools/${tool.slug}/`)} target="_blank" rel="noopener">
              <strong>{tool.name}</strong>
              <span>{tool.body}</span>
              <small aria-hidden="true">kakerio.com ↗</small>
              <span class="sr-only">{t.kakerio.newTab}</span>
            </a>
          </li>
        ))}
      </ul>
      {t.kakerio.languageNote && <p class="kakerio-note">{t.kakerio.languageNote}</p>}
      <a class="kakerio-all" href={kakerioUrl(locale)} target="_blank" rel="noopener">{t.kakerio.all} <span aria-hidden="true">↗</span><span class="sr-only">{t.kakerio.newTab}</span></a>
    </section>

    <section class="seo-copy faq-section">
      <h2>{t.faqTitle}</h2>
      <div class="faq-list">
        {t.faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="privacy-note-footer">
      <p>{t.privacyNote}</p>
    </div>
  </main>

  <footer class="footer">
    <nav class="footer-links" aria-label="Site links">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
    </nav>
  </footer>
</BaseLayout>
